{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark_id", "source_ground_truth", "required_dependencies", "tests_or_absent", "answer_evaluations", "runtime_or_dynamic_notes", "validation_limitations"],
  "properties": {
    "benchmark_id": {"type": "string", "enum": ["Q1", "Q2", "Q3", "Q4"]},
    "source_ground_truth": {"type": "string"},
    "required_dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "file", "symbol", "critical", "description", "source_evidence"],
        "properties": {
          "id": {"type": "string"}, "file": {"type": "string"}, "symbol": {"type": "string"},
          "critical": {"type": "boolean"}, "description": {"type": "string"}, "source_evidence": {"type": "string"}
        }
      }
    },
    "tests_or_absent": {"type": "string"},
    "answer_evaluations": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["answer_id", "verdict", "claims", "required_dependency_ids_found", "required_dependency_ids_missed", "critical_omissions", "invented_or_unsupported_edges", "unsupported_runtime_claims", "citation_issues", "coverage_note"],
        "properties": {
          "answer_id": {"type": "string", "enum": ["R1-X", "R1-Y", "R2-X", "R2-Y"]},
          "verdict": {"type": "string", "enum": ["complete", "partial", "poor"]},
          "claims": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["claim", "verdict", "evidence", "dependency_id"],
              "properties": {
                "claim": {"type": "string"}, "verdict": {"type": "string", "enum": ["correct", "false", "unsupported"]},
                "evidence": {"type": "string"}, "dependency_id": {"type": ["string", "null"]}
              }
            }
          },
          "required_dependency_ids_found": {"type": "array", "items": {"type": "string"}},
          "required_dependency_ids_missed": {"type": "array", "items": {"type": "string"}},
          "critical_omissions": {"type": "array", "items": {"type": "string"}},
          "invented_or_unsupported_edges": {"type": "array", "items": {"type": "string"}},
          "unsupported_runtime_claims": {"type": "array", "items": {"type": "string"}},
          "citation_issues": {"type": "array", "items": {"type": "string"}},
          "coverage_note": {"type": "string"}
        }
      }
    },
    "runtime_or_dynamic_notes": {"type": "array", "items": {"type": "string"}},
    "validation_limitations": {"type": "array", "items": {"type": "string"}}
  }
}
